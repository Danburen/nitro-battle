{
  "name": "nitro-battle",
  "private": true,
  "version": "0.1.0",
  "description": "Nitro Battle · 硝基战役 — 基于 Voronoi 大地图生成的单机回合制大战略游戏",
  "author": "Nitro Battle",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --port 5000",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test src/tests/*-regression.ts",
    "gen:names": "node src/tools/gen-names.ts",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.4"
  }
}
